# Environment variables (PowerShell: $env:DATA_DIR='D:/data/vitasenior')
DATA_DIR=./data
SCANNER_ENABLED=false
CORS_ORIGINS=http://localhost:5173
APP_ENV=demo
PUBLIC_BASE_URL=http://localhost:8000
APP_TIMEZONE=Asia/Hong_Kong
CHAT_PROVIDER=mock
# Real understanding (C's adapter). Leave the key empty for a mock start;
# CHAT_PROVIDER=real refuses to boot unless all three are set. The app does NOT
# auto-load .env files: export these variables in the shell (or your supervisor).
CHAT_API_KEY=
CHAT_BASE_URL=
CHAT_MODEL=
ASR_PROVIDER=mock
TTS_PROVIDER=mock
WEB_PUSH_ENABLED=false
# Media tickets: short-lived HMAC links so <audio>/<img> can load without Bearer.
# Set a real secret (>=16 chars) on any shared or demo machine.
MEDIA_TICKET_SECRET=dev-only-media-ticket-secret
MEDIA_TICKET_SECONDS=300
# Optional SQLite file URL; otherwise DATA_DIR/vitasenior.sqlite3
# DATABASE_URL=sqlite:///D:/data/vitasenior/vitasenior.sqlite3
