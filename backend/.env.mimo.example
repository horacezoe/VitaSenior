# MiMo F2 example. Copy this file to .env and fill in your OWN key.
# .env is ignored by Git. This example must never contain a real credential.
# Environment files are NOT loaded automatically by the application.

# Paste the MiMo API key here in your LOCAL .env only.
CHAT_API_KEY=
CHAT_BASE_URL=https://api.xiaomimimo.com/v1
# Lightweight MiMo chat tier with image + JSON support; account access must be verified.
# The adapter disables MiMo deep thinking to reduce reasoning tokens/latency.
CHAT_MODEL=mimo-v2.6-flash

# Safe default: mock needs no key. After filling your own key, set CHAT_PROVIDER=real.
# A's normal factory supports real chat. Export these values into the process explicitly.
CHAT_PROVIDER=mock
ASR_PROVIDER=mock
ASR_API_KEY=
ASR_BASE_URL=https://api.xiaomimimo.com/v1
ASR_MODEL=mimo-v2.5-asr
TTS_PROVIDER=mock
TTS_API_KEY=
TTS_BASE_URL=https://api.xiaomimimo.com/v1
TTS_MODEL=mimo-v2.5-tts-voicedesign
TTS_VOICE=清澈温暖的小男孩声音，普通话清晰，语速稍慢，亲切耐心。
# For the real demo, fill all three *_API_KEY values with your own MiMo key
# and set CHAT_PROVIDER, ASR_PROVIDER and TTS_PROVIDER to real.
# ASR requires complete PCM WAV from browser capture, not a renamed WebM.
# Real supplier probes require explicit opt-in; no paid requests on normal startup.
LIVE_UNDERSTANDING=0

# Independent C demo data. Do not point this at an existing F1 demo database.
DATA_DIR=data/f2-c-mimo
PUBLIC_BASE_URL=http://127.0.0.1:8003
CORS_ORIGINS=http://localhost:5173
APP_ENV=demo
APP_TIMEZONE=Asia/Hong_Kong
SCANNER_ENABLED=false
MEDIA_TICKET_SECRET=replace-with-your-own-random-32-byte-secret
MEDIA_TICKET_SECONDS=300
